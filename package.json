{
  "name": "github-copilot-arazzo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A visual Arazzo workflow canvas for GitHub Copilot. Development tooling only: the plugin itself has no runtime dependency.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/acceptance/*.test.mjs\" \"tests/integration/*.test.mjs\" \"tests/architecture/*.test.mjs\" \"tests/tooling/*.test.mjs\"",
    "test:acceptance": "node --test \"tests/acceptance/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "test:architecture": "node --test \"tests/architecture/*.test.mjs\"",
    "test:tooling": "node --test \"tests/tooling/*.test.mjs\"",
    "test:coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.mjs\" --test-coverage-exclude=\"src/infrastructure/vendor/**\" --test-coverage-exclude=\"src/presentation/ui/**\" --test-coverage-lines=100 --test-coverage-branches=95 --test-coverage-functions=95 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"tests/acceptance/*.test.mjs\" \"tests/integration/*.test.mjs\" \"tests/architecture/*.test.mjs\"",
    "test:e2e": "playwright test",
    "lint": "node --check src/composition.mjs && node --check src/presentation/ui/app.mjs && node --check com.github.copilot/extensions/arazzo-canvas/extension.mjs",
    "mutation:core": "stryker run stryker.core.config.json",
    "mutation:boundary": "stryker run stryker.boundary.config.json",
    "quality-bar": "node scripts/check-quality-bar.mjs",
    "video": "node video/serve.mjs",
    "video:export": "node video/export.mjs",
    "video:audio": "node video/audio.mjs"
  },
  "devDependencies": {
    "@babel/standalone": "^7.29.11",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@playwright/test": "^1.49.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/tap-runner": "10.1.1",
    "ffmpeg-static": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SebastienDegodez/github-copilot-arazzo.git"
  }
}
