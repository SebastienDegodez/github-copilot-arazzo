{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "mutate": ["src/infrastructure/*.mjs", "src/presentation/*.mjs", "src/composition.mjs"],
  "tap": {
    "testFiles": ["tests/integration/*.test.mjs"],
    "nodeArgs": ["--test-reporter=tap", "--test-reporter-destination=stdout"]
  },
  "reporters": ["json", "clear-text", "progress"],
  "thresholds": { "high": 80, "low": 80, "break": 80 },
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "timeoutMS": 30000
}
